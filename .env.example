DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/universite_virtuelle?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/universite_virtuelle/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH.storage.YOUR_REGION.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=SERVER_ONLY_STORAGE_CREDENTIAL_ID
AWS_SECRET_ACCESS_KEY=SERVER_ONLY_STORAGE_SECRET
CAMPUS_STORAGE_BUCKET=campus-private
# Optional transactional mail; in-app notifications work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
